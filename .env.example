# Generated secrets are created by make start-dev; never commit .env.
PG_PASS=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_PASSWORD=
OIDC_CLIENT_SECRET=
NEXTAUTH_SECRET=
# Local delivery. Replace these values with your SMTP service when needed.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=login@example.test
SMTP_USE_TLS=false
SMTP_USE_SSL=false
